{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ parent() }}

    {{ fields.smallTitle(__('Authentication', 'webhookbearerapi'), 'ti ti-lock') }}

    {{ fields.dropdownField(
        'Webhook',
        'webhooks_id',
        item.fields['webhooks_id']|default(0),
        _n('Webhook', 'Webhooks', 1, 'webhookbearerapi'),
        {
            'toadd': {0: __('None')},
            'rand': rand
        }
    ) }}

    {{ fields.urlField(
        'token_url',
        item.fields['token_url'],
        __('Token URL', 'webhookbearerapi'),
        {'required': true, 'rand': rand}
    ) }}

    {{ fields.dropdownArrayField(
        'grant_type',
        item.fields['grant_type'],
        grant_types,
        __('Grant type', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.dropdownArrayField(
        'auth_method',
        item.fields['auth_method'],
        auth_methods,
        __('Client credentials method', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.dropdownArrayField(
        'body_format',
        item.fields['body_format'],
        body_formats,
        __('Token request content type', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.textField(
        'client_id',
        item.fields['client_id'],
        __('Client ID'),
        {'rand': rand}
    ) }}

    {{ fields.passwordField(
        'client_secret',
        '',
        __('Client secret', 'webhookbearerapi'),
        {
            'rand': rand,
            'additional_attributes': {
                'autocomplete': 'new-password',
                'placeholder': item.fields['client_secret'] is not empty ? '••••••' : ''
            }
        }
    ) }}

    {{ fields.textField(
        'username',
        item.fields['username'],
        _n('User', 'Users', 1, 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.passwordField(
        'password',
        '',
        __('Password'),
        {
            'rand': rand,
            'additional_attributes': {
                'autocomplete': 'new-password',
                'placeholder': item.fields['password'] is not empty ? '••••••' : ''
            }
        }
    ) }}

    {{ fields.textField(
        'scope',
        item.fields['scope'],
        _n('Scope', 'Scopes', 1, 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.textareaField(
        'extra_params',
        item.fields['extra_params'],
        __('Additional parameters (JSON)', 'webhookbearerapi'),
        {
            'enable_richtext': false,
            'rows': 3,
            'rand': rand
        }
    ) }}

    {{ fields.smallTitle(__('Token response parsing', 'webhookbearerapi'), 'ti ti-braces') }}

    {{ fields.textField(
        'token_field',
        item.fields['token_field'],
        __('Token field', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.textField(
        'expires_in_field',
        item.fields['expires_in_field'],
        __('Expiration delay field', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.numberField(
        'default_expires_in',
        item.fields['default_expires_in'],
        __('Default validity duration (seconds)', 'webhookbearerapi'),
        {'min': 60, 'max': 86400, 'step': 60, 'rand': rand}
    ) }}

    {{ fields.smallTitle(__('Bearer token header', 'webhookbearerapi'), 'ti ti-plug-connected') }}

    {{ fields.textField(
        'header_name',
        item.fields['header_name'],
        __('Header name', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.textField(
        'token_prefix',
        item.fields['token_prefix'],
        __('Token prefix', 'webhookbearerapi'),
        {'rand': rand}
    ) }}

    {{ fields.numberField(
        'refresh_margin',
        item.fields['refresh_margin'],
        __('Refresh margin (seconds)', 'webhookbearerapi'),
        {
            'min': 0,
            'max': 86400,
            'step': 30,
            'rand': rand,
            'add_field_html': '<span class="text-muted small">' ~ __('The token is renewed this much time before its expiration.', 'webhookbearerapi') ~ '</span>'
        }
    ) }}

    {% if not item.isNewItem() %}
        {{ fields.smallTitle(__('Bearer token', 'webhookbearerapi'), 'ti ti-key') }}

        {% set token_html %}
            {% if item.fields['access_token'] is not empty and item.fields['token_expires_at'] is not empty %}
                {% if item.fields['token_expires_at'] > 'now'|date('Y-m-d H:i:s') %}
                    <span class="text-success">
                        <i class="ti ti-circle-check"></i>
                        {{ __('Valid until %s', 'webhookbearerapi')|format(item.fields['token_expires_at']|formatted_datetime(true)) }}
                    </span>
                {% else %}
                    <span class="text-warning">
                        <i class="ti ti-clock-exclamation"></i>
                        {{ __('Expired since %s', 'webhookbearerapi')|format(item.fields['token_expires_at']|formatted_datetime(true)) }}
                    </span>
                {% endif %}
            {% else %}
                <span class="text-danger">
                    <i class="ti ti-circle-x"></i>
                    {{ __('No token yet', 'webhookbearerapi') }}
                </span>
            {% endif %}

            {% if item.fields['last_refresh'] is not empty %}
                <div class="text-muted small">
                    {{ __('Last refresh: %s', 'webhookbearerapi')|format(item.fields['last_refresh']|formatted_datetime(true)) }}
                </div>
            {% endif %}

            {% if item.fields['last_error'] is not empty %}
                <div class="text-danger small">{{ __('Last error: %s', 'webhookbearerapi')|format(item.fields['last_error']) }}</div>
            {% endif %}
        {% endset %}

        {{ fields.htmlField('_token_status', token_html, __('Token status', 'webhookbearerapi')) }}

        <div class="col-12 col-xxl-6 d-flex align-items-end mb-3">
            <button type="submit" name="refresh" value="1" class="btn btn-ghost-secondary">
                <i class="ti ti-refresh"></i>
                <span class="ms-1">{{ __('Refresh token now', 'webhookbearerapi') }}</span>
            </button>
        </div>
    {% endif %}
{% endblock %}
